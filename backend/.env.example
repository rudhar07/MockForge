# Copy to .env and fill in real values. Never commit .env.

PORT=5001

# Local Docker MongoDB (see README) or your MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/mockforge

# Any long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=change_me

# Optional — enables code execution (Judge0 CE on RapidAPI)
RAPIDAPI_KEY=

# Optional — enables the AI coach review
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
